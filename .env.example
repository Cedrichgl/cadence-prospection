# Copiez ce fichier en .env pour le développement local. Ne le commitez jamais.

# Mot de passe pour se connecter à l'application
APP_PASSWORD=choisissez-un-mot-de-passe-long
# Clé de signature des sessions (une longue chaîne aléatoire)
SECRET_KEY=remplacez-moi-par-une-longue-chaine-aleatoire
# Clé API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optionnel
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/cadence   (SQLite si vide)
# CLAUDE_MODEL=claude-opus-5-5
# MORNING_EFFORT=medium        (low | medium | high)
# MORNING_TARGET=10            (prospects par matin)
# COOKIE_SECURE=0              (seulement en local, sans HTTPS)
